<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="ja-JP" page-range-format="expanded">
  <info>
    <title>日本小児科学会雑誌 (custom)</title>
    <title-short>日児誌 (custom)</title-short>
    <id>https://github.com/KotaYoneda/csl-styles/journals/jjps</id>
    <link href="https://github.com/KotaYoneda/csl-styles/journals/jjps" rel="self"/>
    <link href="https://www.jpeds.or.jp/" rel="documentation"/>
    <contributor>
      <name>Kota Yoneda</name>
      <uri>https://github.com/KotaYoneda</uri>
    </contributor>
    <category citation-format="numeric"/>
    <category field="medicine"/>
    <summary>日本小児科学会雑誌 投稿規程（2025年4月1日実施）3-12 引用文献に準拠したカスタムスタイル</summary>
    <updated>2026-11-13T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale>
    <style-options punctuation-in-quote="false"/>
    <terms>
      <term name="et-al">et al</term>
      <term name="editor" form="short">
        <single>ed</single>
        <multiple>eds</multiple>
      </term>
      <term name="page-range-delimiter">-</term>
      <term name="citation-range-delimiter">-</term>
      <term name="open-quote">“</term>
      <term name="close-quote">”</term>
      <term name="accessed">参照</term>
      <term name="edition" form="short">ed</term>
      <term name="ordinal">th</term>
      <term name="ordinal-01">st</term>
      <term name="ordinal-02">nd</term>
      <term name="ordinal-03">rd</term>
      <term name="ordinal-11">th</term>
      <term name="ordinal-12">th</term>
      <term name="ordinal-13">th</term>
    </terms>
  </locale>

  <!-- 著者名: 3名まで全員、4名以上は最初の3名 + , et al -->
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " initialize-with="" delimiter=", " delimiter-precedes-last="always" et-al-min="4" et-al-use-first="3"/>
      <et-al term="et-al"/>
      <substitute>
        <text macro="editor"/>
      </substitute>
    </names>
  </macro>

  <macro name="editor">
    <names variable="editor">
      <name name-as-sort-order="all" sort-separator=" " initialize-with="" delimiter=", " delimiter-precedes-last="always" et-al-min="4" et-al-use-first="3"/>
      <et-al term="et-al"/>
      <label form="short" prefix=", "/>
    </names>
  </macro>

  <macro name="publisher">
    <group delimiter=":">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>

  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>

  <macro name="accessed">
    <group prefix="(" suffix=")" delimiter=" ">
      <text term="accessed"/>
      <date variable="accessed" delimiter="-">
        <date-part name="year"/>
        <date-part name="month" form="numeric"/>
        <date-part name="day"/>
      </date>
    </group>
  </macro>

  <macro name="url-accessed">
    <choose>
      <if variable="URL">
        <group delimiter=",">
          <text variable="URL"/>
          <text macro="accessed"/>
        </group>
      </if>
    </choose>
  </macro>

  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout vertical-align="sup" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography second-field-align="flush" entry-spacing="0">
    <layout>
      <text variable="citation-number" suffix=") "/>
      <choose>
        <!-- 1) 雑誌: 著者名. 表題. 雑誌名 発行年;巻:最初ページ-最終ページ. -->
        <if type="article-journal article-magazine article-newspaper" match="any">
          <group delimiter=". " suffix=".">
            <text macro="author"/>
            <text variable="title"/>
            <group delimiter=" ">
              <text variable="container-title" form="short" strip-periods="true"/>
              <group>
                <date variable="issued">
                  <date-part name="year"/>
                </date>
                <text variable="volume" prefix=";"/>
                <text variable="page" prefix=":"/>
              </group>
            </group>
          </group>
        </if>
        <!-- 2) 単行本: 著者名. 書名. 版数. 所在地:発行社, 発行年. -->
        <else-if type="book report thesis" match="any">
          <group delimiter=". " suffix=".">
            <text macro="author"/>
            <text variable="title"/>
            <text macro="edition"/>
            <group delimiter=", ">
              <text macro="publisher"/>
              <date variable="issued">
                <date-part name="year"/>
              </date>
            </group>
          </group>
          <text macro="url-accessed" prefix=" "/>
        </else-if>
        <!-- 3) 分担執筆: 著者名. 分担部分の表題. In:編者名, eds. 書名. 版数. 所在地:発行社, 発行年:最初-最終ページ. -->
        <else-if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
          <group delimiter=". " suffix=".">
            <text macro="author"/>
            <text variable="title"/>
            <group>
              <text value="In:"/>
              <text macro="editor"/>
            </group>
            <text variable="container-title"/>
            <text macro="edition"/>
            <group delimiter=":">
              <group delimiter=", ">
                <text macro="publisher"/>
                <date variable="issued">
                  <date-part name="year"/>
                </date>
              </group>
              <text variable="page"/>
            </group>
          </group>
        </else-if>
        <!-- 8) Web: 著者名. "題名". サイト名. URL,(参照 YYYY-M-D) -->
        <else-if type="webpage post-weblog post" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text variable="title" quotes="true"/>
            <text variable="container-title"/>
            <text macro="url-accessed"/>
          </group>
        </else-if>
        <!-- その他 -->
        <else>
          <group delimiter=". " suffix=".">
            <text macro="author"/>
            <text variable="title"/>
            <text variable="container-title" form="short" strip-periods="true"/>
            <group delimiter=", ">
              <text macro="publisher"/>
              <date variable="issued">
                <date-part name="year"/>
              </date>
            </group>
          </group>
          <text macro="url-accessed" prefix=" "/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
